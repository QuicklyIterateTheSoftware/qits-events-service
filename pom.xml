<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for qits-events — the EVENT context: a recorded thing that happened, with
         a name, a time and a description, addressable by the platform's other services. Unlike its
         siblings this repo was not extracted from the monorepo; it starts as a skeleton, and the
         skeleton is deliberate. What is here is the SHAPE every qits service has (a library-jar
         domain layer, a deployable `service` that owns the web surface and the client, its own
         datasource and its own Flyway lineage) with the smallest possible amount of behaviour
         hanging off it, so that the first real feature is written against a structure that is
         already right rather than one invented under pressure.

         DELIBERATELY ITS OWN GAV, the same case as qits-ci and qits-projects. The child directories
         are `events` and `service`, and `eu.wohlben:service` would collide in the shared ~/.m2 that
         every workspace container mounts. So the coordinates are namespaced
         (`eu.wohlben.qits:qits-events-*`) while the directories stay short. The `events/` module's
         artifactId is `qits-events-domain` and not `qits-events-events`, which would be nonsense —
         the directory names the context, the artifactId names the layer (the qits-ci precedent).

         Versions that must stay in step with the platform (Quarkus, JDK release, MapStruct, Lombok,
         Quinoa) are duplicated here on purpose: a clone of THIS repo alone must build, with no
         monorepo and no parent to inherit from. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-events</artifactId>
    <version>2026.1002.125850</version>
    <packaging>pom</packaging>
    <name>qits-events</name>

    <modules>
        <!-- Listed first: `service` depends on it. -->
        <module>events</module>
        <module>service</module>
    </modules>

    <properties>
        <!-- THE PLATFORM'S OWN MAVEN REPOSITORY, and this repo's first two artifacts from it:
             qits-db-core (PatientPgDriver, which the events datasource opens every connection
             through, and DbRetry.inNewTx, which the two write paths run in) and qits-arch-rules
             (the test that refuses to let the datasource baseline go missing). Both are published
             by qits-integrations-quarkus. The url is a property so the
             image build can point it at the address the builder container can actually reach —
             see docker/Dockerfile and .qits-maven-settings.xml. -->
        <qits.db-core.version>2026.1002.70617</qits.db-core.version>
        <qits.arch-rules.version>2026.1002.70617</qits.arch-rules.version>
        <qits.auth-core.version>2026.1002.70617</qits.auth-core.version>
        <!-- The user-story framework (TEST SCOPE ONLY). The story catalogue lives in
             service/src/test/java/…/events/stories/ (plus EventBusBootstrapIT beside the API it
             tells), so a `mvn verify -DskipITs=false -Dit.test=<the classes>` regenerates
             service/target/userstories/ — eight stories in six categories, each with its observed
             network diagram. Published out of libs/qits-userflows into the same platform Maven
             repository the three jars above come from, so the <repositories> block below already
             reaches it. This pin also carries NetworkTaps, the shipped RestAssured tap the
             catalogue installs instead of the per-repo StoryNetworkFilter copy four
             repositories had been carrying.

             There is deliberately NO qits-service-mock here, unlike the userflow poms of
             qits-githost and qits-platform-deployments. Those two stand a recording MockIdp up
             because their stories are about a service they DIAL; this one dials nobody. qits-events
             is the far side of every interaction on the platform, so the stories' counterparties are
             a real HTTP client and a real websocket client in the test JVM, and a mock would be a
             stand-in for nothing. -->
        <qits.userflows.version>2026.1002.72731</qits.userflows.version>
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- The OTLP wire's generated message classes, TEST SCOPE ONLY (declared in service/pom.xml)
             — what OtlpLogStub decodes an ExportLogsServiceRequest with, so the log-bridge proof
             reads the bytes Quarkus actually exported instead of trusting that something arrived.
             Not in the platform BOM, so pinned here; qits-observability, which decodes the same
             messages in PRODUCTION code, pins the same version. The "-alpha" is about the Java
             API's stability, not the wire's — the OTLP protobuf definitions are Stable. Don't
             auto-bump. protobuf-java arrives with it and IS in the platform BOM, so it is not
             pinned here. -->
        <opentelemetry-proto.version>1.7.0-alpha</opentelemetry-proto.version>

        <!-- Quinoa is in NO BOM, so the version is pinned here rather than inherited, and it is
             pinned in the PARENT rather than beside the dependency so there is one place to read it
             from when the platform's Quarkus moves. 2.8.2 is the last release built against a
             Quarkus OLDER than the platform's 3.34.6 (3.27.3 LTS — the compatible direction); 2.8.3
             is built against 3.36.2, ahead of us. Bump only when the platform's Quarkus passes the
             version a Quinoa release is built against
             (docs/project-setup-quinoa-angular.md in the qits superproject). -->
        <quinoa.version>2.8.2</quinoa.version>

        <!-- Embedded PostgreSQL for the suites. This service's store IS postgres now, so every test
             that touches SQL has to run against one — and the first rule here is that a clone tests
             green with NO DOCKER, which rules out Testcontainers and Quarkus dev services alike.
             Zonky resolves real postgres binaries as ordinary Maven artifacts and spawns them as a
             child process: a maven dependency, not a container.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0 — the
             platform's own postgres tag), the library version is the harness around them, and they
             move independently. Every architecture the suite may run on is named explicitly in the
             modules that use it: the binaries are per-arch artifacts, and a missing one fails in the
             middle of a suite rather than during resolution. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- PackagedSurfaceIT runs against the BUILT artifact, so it needs a `package` to have
             happened and — because this service carries a client — a checked-out webui submodule and
             a node on PATH. A plain `./mvnw verify` on a fresh clone has neither, and the clone-alone
             rule says it must still be green. `-DskipITs=false` (or `-Dnative`, which flips this in
             service/pom.xml's profile) is how you ask for the artifact to be probed. -->
        <skipITs>true</skipITs>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE — 18.4.0, the tag the platform's own
                     qits-oci-postgresql image is built from. The suites migrate and query against
                     the same major version the deployment runs, which is the whole reason a real
                     server is spawned rather than an in-memory stand-in. Imported as a BOM because
                     the per-arch artifacts are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.proto</groupId>
                <artifactId>opentelemetry-proto</artifactId>
                <version>${opentelemetry-proto.version}</version>
            </dependency>
            <dependency>
                <!-- The Angular client in service/src/main/webui. See the pin's reasoning at
                     quinoa.version above; the dependency itself is declared in service/pom.xml. -->
                <groupId>io.quarkiverse.quinoa</groupId>
                <artifactId>quarkus-quinoa</artifactId>
                <version>${quinoa.version}</version>
            </dependency>
            <!-- The reactor's own module, so `service` depends on it version-less. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-events-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-auth-core</artifactId>
                <version>${qits.auth-core.version}</version>
            </dependency>
            <dependency>
                <!-- PatientPgDriver, named only by the datasource's `jdbc.driver` line, and
                     DbRetry.inNewTx, which EventService's two write paths call. The second is why
                     `events` declares it at compile scope rather than runtime. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-db-core</artifactId>
                <version>${qits.db-core.version}</version>
            </dependency>
            <dependency>
                <!-- The platform's shared rules, test scope. DatasourceBaselineRules is what this
                     repo takes them for. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-arch-rules</artifactId>
                <version>${qits.arch-rules.version}</version>
            </dependency>
            <dependency>
                <!-- The userflow framework. Test scope, in `service/` only: the stories run against
                     the PACKAGED artifact, and that is the one module of the two that produces
                     one. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-userflows</artifactId>
                <version>${qits.userflows.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <!-- Where the two qits jars above come from. Named `qits-maven` because the image
                 build's settings file mirrors exactly that id — see .qits-maven-settings.xml. -->
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the monorepo disables it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
